{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'no dependencies'",
  "buildCommand": "node build.js",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/design",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/design/(.*)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/photography",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/photography/(.*)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/projects",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/projects/(.*)",
      "destination": "/",
      "permanent": false
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "images": {
    "sizes": [
      640,
      1080,
      1600,
      2400
    ],
    "formats": [
      "image/avif",
      "image/webp"
    ],
    "minimumCacheTTL": 2678400,
    "localPatterns": [
      {
        "pathname": "/media/**"
      }
    ]
  }
}