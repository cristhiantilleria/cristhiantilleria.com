---
// One gallery tile per project on /work: a large image with a quiet caption underneath. Without a cover it falls back to an abstract placeholder.
import ResponsiveImage from './ResponsiveImage.astro';
import { img, pad, type Project } from '../lib/content';
interface Props { project: Project; index: number }
const { project: p, index: i } = Astro.props;
const still = p.cover ? img(p.cover, 1080) : '';
---
<a class="work" href={`/work/${p.slug}`} data-reveal>
  <div class="work__frame"><div class="media">{
    p.video
      ? <video class="art art--vid" src={encodeURI(p.video)} poster={still || undefined} muted loop playsinline preload="metadata" data-autoplay></video>
      : p.cover
        ? <ResponsiveImage class="art art--img" src={p.cover} sizes="(max-width: 760px) 100vw, 50vw" maxW={1600} priority={i < 2} alt={`${p.title} — ${(p.type || 'project').toLowerCase()} by Cristhian Tilleria`} />
        : <div class={`art art-${(i % 3) + 1}`}></div>
  }</div></div>
  <div class="work__info">
    <span class="work__n mono">{pad(i + 1, 2)}</span>
    <h3 class="work__title">{p.title}<i aria-hidden="true">↗</i></h3>
    <span class="work__type mono muted">{[p.type, p.year].filter(Boolean).join(' — ')}</span>
  </div>
</a>
