---
import Base from '../layouts/Base.astro';
import Btn from '../components/Btn.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import { getSite, img } from '../lib/content';

const site = await getSite();
---
<Base view="about" title="About Cristhian Tilleria — Independent Web Designer in New York" description={site.statement} image={site.portrait}>
  <section class:list={['page grid', { 'has-portrait': site.portrait }]}>
    <p class="page__kicker mono" data-reveal><span data-type>About — Cristhian Tilleria</span></p>
    <h1 class="statement still">{site.statement}</h1>
    {site.portrait && (
      <figure class="portrait" data-reveal data-wait="500">
        <div class="media"><ResponsiveImage src={site.portrait} alt="Portrait of Cristhian Tilleria" sizes="(max-width: 700px) 90vw, 40vw" maxW={1080} priority /></div>
        <figcaption class="mono"><span>Cristhian Tilleria</span><span>New York</span></figcaption>
      </figure>
    )}
    <dl class="facts" data-reveal>
      <div class="fade" style="--d:0"><dt class="mono">Based in</dt><dd>New York, US<br>Working with clients anywhere</dd></div>
      <div class="fade" style="--d:120"><dt class="mono">What I do</dt><dd>{site.services.map((s, i) => <>{i > 0 && <br />}{s.title}</>)}</dd></div>
      <div class="fade" style="--d:240"><dt class="mono">Status</dt><dd><span class="avail"><span class="dot"></span>{site.status}</span></dd></div>
    </dl>
    <div class="cta-row fade" data-reveal>
      <Btn href="/contact">Book a call</Btn>
      <a class="link mono" href="/work" data-sweep>See the work</a>
    </div>
  </section>
</Base>
